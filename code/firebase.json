{
  "hosting": {
    "site": "ch-ai-portfolio",
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/resume/**",
        "function": {
          "functionId": "resume-api",
          "region": "asia-south1"
        }
      },
      {
        "source": "/api/visit",
        "function": {
          "functionId": "visit-api",
          "region": "asia-south1"
        }
      }
    ],
    "headers": [
      {
        "source": "/api/resume*.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      }
    ]
  }
}
