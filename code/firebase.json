{
  "hosting": {
    "site": "ch-ai-portfolio",
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/resume/**",
        "function": {
          "functionId": "resume-api",
          "region": "asia-south1"
        }
      }
    ]
  }
}
