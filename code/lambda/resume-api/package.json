{
  "name": "ch-ai-resume-api",
  "version": "1.0.0",
  "private": true,
  "description": "Lambda behind CloudFront (/api/resume/request) that gates the resume download: validates + captchas the submission, logs a telemetry row to DynamoDB, and returns a short-lived presigned S3 URL.",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outfile=dist/handler.js --minify",
    "compile": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.11.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
